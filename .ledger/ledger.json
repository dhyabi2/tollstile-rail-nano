  },
  {
   "id": "L1",
   "block": 1.0,
   "statement": "A failed handler refunds the nano payment by reverse send.",
   "test": "upfront charge refunded on handler failure",
   "scope": [
    "src/**.ts"
   ],
   "oracle": "cd /root/work/tollstile-rail-nano && npx vitest run test/rail.test.ts 2>&1",
   "expect": "Tests +passed",
   "source": null,
   "grounding": "oracle",
   "version": 3,
   "minted": "2026-09-22T10:57:16+00:00"
  },
  {
   "id": "L2",
   "block": 2.0,
   "statement": "The rail declares quotes and admits a payment only when the presented block's amount exactly matches an unexpired quote for this request.",
   "test": "off-quote, expired-quote, and wrong-amount blocks are rejected; the quoted block settles",
   "scope": [
    "test/**.ts"
   ],
   "oracle": "cd /root/work/tollstile-rail-nano && npx vitest run --reporter=verbose test/security.test.ts 2>&1",
   "expect": "Test Files +1 passed",
   "source": null,
   "grounding": "oracle",
   "version": 2,
   "minted": "2026-09-24T08:42:51+00:00"
  },
  {
   "id": "L3",
   "block": 2.0,
   "statement": "The rail verifies an ed25519 signature over the quote nonce against the paying block's source account, so only the payer who holds that key can present the block.",
   "test": "absent or forged presenter signature is rejected; the payer's own signature over the fresh nonce is accepted",
   "scope": [
    "test/**.ts"
   ],
   "oracle": "cd /root/work/tollstile-rail-nano && npx vitest run --reporter=verbose test/security.test.ts 2>&1",
   "expect": "Test Files +1 passed",
   "source": null,
   "grounding": "oracle",
   "version": 2,
   "minted": "2026-09-24T08:42:59+00:00"
  },
  {
   "id": "L4",
   "block": 3.0,
   "statement": "The rail requires an explicit exchange rate at build time and never lets the payer name the amount, so a volatile asset is not converted at a silent default.",
   "test": "nanoRail() without a rate throws; client-carried amount headers are ignored",
   "scope": [
    "test/**.ts"
   ],
   "oracle": "cd /root/work/tollstile-rail-nano && npx vitest run --reporter=verbose test/security.test.ts 2>&1",
   "expect": "Test Files +1 passed",
   "source": null,
   "grounding": "oracle",
