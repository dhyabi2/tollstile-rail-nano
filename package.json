{
  "name": "tollstile-rail-nano",
  "version": "0.3.2",
  "description": "A Nano (XNO) settlement rail for Tollstile: instance-fast, feeless, peer-to-peer machine payments. An upfront push-payment rail where a payer-presented confirmed Nano send block is the payment (paid at verification); refunds for failed handlers are reverse sends.",
  "type": "module",
  "license": "MIT",
  "author": "dhyabi2",
  "keywords": [
    "tollstile-rail",
    "nano",
    "xno",
    "tollstile",
    "x402",
    "mpp",
    "payments",
    "agent-payments",
    "machine-payments",
    "ai-agents",
    "feeless",
    "rail"
  ],
  "peerDependencies": {
    "tollstile": "^0.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhyabi2/tollstile-rail-nano.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.0.0"
  },
  "homepage": "https://github.com/dhyabi2/tollstile-rail-nano#readme",
  "bugs": {
    "url": "https://github.com/dhyabi2/tollstile-rail-nano/issues"
  }
}
